<Page x:Class="EMCalculator.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <NavigationView x:Name="Navigation" Background="Transparent" IsSettingsVisible="False" IsBackButtonVisible="Collapsed" PaneTitle="EM Calculator" PaneDisplayMode="Auto" IsTextScaleFactorEnabled="True" SelectionChanged="Navigation_SelectionChanged">
        <NavigationView.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Default">
                        <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{ThemeResource SystemColorWindowColor}" />
                        <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </NavigationView.Resources>
        <NavigationView.MenuItems>
            <NavigationViewItemHeader x:Name="BasicsHeader" />
            <NavigationViewItem x:Name="BandwidthNav" Tag="bandwidth" Icon="Calculator" IsTextScaleFactorEnabled="True" />
            <NavigationViewItem x:Name="ApertureNav" Tag="aperture" Icon="Globe" IsTextScaleFactorEnabled="True" />
            <NavigationViewItem x:Name="WavelengthNav" Tag="wavelength" Icon="World" IsTextScaleFactorEnabled="True" />
            <NavigationViewItemHeader x:Name="AntennaDesignHeader" />
            <NavigationViewItem x:Name="PatchNav" Tag="patch" Icon="World" IsTextScaleFactorEnabled="True" />
            <NavigationViewItem x:Name="ArrayNav" Tag="array" Icon="AllApps" IsTextScaleFactorEnabled="True" />
            <NavigationViewItemHeader x:Name="StructuresHeader" />
            <NavigationViewItem x:Name="LineNav" Tag="line" Icon="Link" IsTextScaleFactorEnabled="True" />
            <NavigationViewItem x:Name="SiwNav" Tag="siw" Icon="AllApps" IsTextScaleFactorEnabled="True" />
        </NavigationView.MenuItems>
        <NavigationView.PaneFooter>
            <Button x:Name="LanguageButton" Click="Language_Click" Margin="12,4,12,12" IsTextScaleFactorEnabled="True" />
        </NavigationView.PaneFooter>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
            <Grid x:Name="ContentViewport" HorizontalAlignment="Stretch" SizeChanged="ContentViewport_SizeChanged">
                <StackPanel x:Name="ContentPanel" HorizontalAlignment="Center" Margin="32,28,32,48" Spacing="16" />
            </Grid>
        </ScrollViewer>
    </NavigationView>
</Page>
