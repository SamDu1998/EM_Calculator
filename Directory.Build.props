<Project>
  <PropertyGroup>
    <Version>0.6.0</Version>
    <AppxPackageIdentityName>EMCalculator</AppxPackageIdentityName>
    <AppxPackagePublisher>CN=EM Calculator Development</AppxPackagePublisher>
    <AppxPackageVersion>0.6.0.0</AppxPackageVersion>
    <Authors>Sam</Authors>
    <Product>EM Calculator</Product>
    <Description>Native Windows electromagnetic engineering calculator</Description>
    <RepositoryUrl>https://github.com/SamDu1998/EM_Calculator</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Deterministic>true</Deterministic>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)artifacts/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)artifacts/bin/$(MSBuildProjectName)/</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/bin/**;**/obj/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
